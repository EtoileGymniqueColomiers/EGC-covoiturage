# App Store Connect / Apple Developer identifiers
# Override via env: FASTLANE_TEAM_ID, FASTLANE_APPLE_ID, FASTLANE_ITC_TEAM_ID

app_identifier("fr.egc.covoiturage")
team_id(ENV["FASTLANE_TEAM_ID"]) # Developer Portal Team ID (10 chars)

# Optional when using ASC API key for cloud signing + TestFlight upload
apple_id(ENV["FASTLANE_APPLE_ID"]) if ENV["FASTLANE_APPLE_ID"].to_s != ""

itc_team_id(ENV["FASTLANE_ITC_TEAM_ID"]) if ENV["FASTLANE_ITC_TEAM_ID"].to_s != ""
