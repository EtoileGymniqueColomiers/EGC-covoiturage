# Copy to .env and fill in (never commit .env)
#   cp .env.example .env

# Team ID (Apple Developer → Membership details)
FASTLANE_TEAM_ID=XXXXXXXXXX

# Optional Apple ID (not required when using ASC API key cloud signing)
# FASTLANE_APPLE_ID=ton.email@apple.com

# Optional if different from Team ID
# FASTLANE_ITC_TEAM_ID=XXXXXXXXXX

# Required: App Store Connect API Key (Team key, Admin or App Manager)
# App Store Connect → Users and Access → Integrations → App Store Connect API
# Download AuthKey_XXX.p8 and put it in ios/secrets/ (gitignored)
APP_STORE_CONNECT_KEY_ID=XXXXXXXXXX
APP_STORE_CONNECT_ISSUER_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
APP_STORE_CONNECT_KEY_PATH=secrets/AuthKey_XXXXXXXXXX.p8

# Optional notes shown in TestFlight
TESTFLIGHT_CHANGELOG=Nouvelle version

# Required for `fastlane screenshots` (demo parent account — seed via
# supabase/seed_snapshot_user.sql; must NOT be admin so UI lands on app tabs)
SNAPSHOT_EMAIL=user@egc.fr
SNAPSHOT_PASSWORD=EGC-User-2026!
